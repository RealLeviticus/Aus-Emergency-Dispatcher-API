# Copy to .env for local dev. On the VPS this lives at /opt/aed-dispatcher/.env (mode 0600),
# outside git, and is preserved across deploys.
NODE_ENV=development
HOST=0.0.0.0
PORT=3100

# Shared client secret(s). Comma-separated. Leave blank in dev to disable the check.
API_TOKENS=

# Comma-separated allowed origins, or * for any (dev only).
ALLOWED_ORIGINS=*

OWNER_GRACE_MS=60000
CLIENT_IDLE_MS=45000
MAX_OBJECTS_PER_SESSION=500

# --- Discord OAuth for RAAFv access (leave blank to disable RAAFv linking) ---
# Create an app at https://discord.com/developers/applications
#  · OAuth2 redirect: http://127.0.0.1:8737/callback
#  · scopes used: identify guilds guilds.members.read
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8737/callback
# RAAFv Discord server id + the role id(s) that grant access (comma-separated).
# If RAAFV_ROLE_ID is blank, being a member of the guild is enough.
RAAFV_GUILD_ID=
RAAFV_ROLE_ID=
