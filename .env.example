# Copy to .env for local dev. On the VPS this lives at /opt/aed-dispatcher/.env (mode 0600),
# outside git, and is preserved across deploys.
NODE_ENV=development
HOST=0.0.0.0
PORT=3100

# Shared client secret(s). Comma-separated. Leave blank in dev to disable the check.
API_TOKENS=

# Comma-separated allowed origins, or * for any (dev only).
ALLOWED_ORIGINS=*

OWNER_GRACE_MS=60000
CLIENT_IDLE_MS=45000
MAX_OBJECTS_PER_SESSION=500

# --- Discord OAuth for RAAFv access (leave blank to disable RAAFv linking) ---
# Create an app at https://discord.com/developers/applications
#  · OAuth2 redirect: http://127.0.0.1:8737/callback
#  · scopes used: identify guilds guilds.members.read
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8737/callback
# RAAFv Discord server id + the role id(s) that grant access (comma-separated).
# If RAAFV_ROLE_ID is blank, being a member of the guild is enough.
RAAFV_GUILD_ID=
RAAFV_ROLE_ID=

# --- RAAFv crew centre (phpVMS) ---------------------------------------------
# The crew centre proves membership at sign-in with no configuration at all;
# these only affect how much the tasking generator knows about the fleet.
PHPVMS_URL=https://crew.raafvirtual.org

# A crew centre API key, used ONLY to read GET /api/fleet — which is what lets
# tasking name a real tail number and see which base each airframe is parked at.
# Any pilot's key works (it is on their crew centre profile), but use a dedicated
# account so a member leaving does not take fleet data with them.
#
# Leave blank and nothing breaks: /fleet and the generator fall back to RAAFv's
# published order of battle, so squadrons and bases stay correct — jobs just
# cannot quote an individual aircraft. Live flights (GET /api/acars) and the hub
# list are public and work either way.
PHPVMS_API_KEY=
